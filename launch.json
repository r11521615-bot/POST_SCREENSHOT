{
    // 使用 IntelliSense 以得知可用的屬性。
    // 暫留以檢視現有屬性的描述。
    // 如需詳細資訊，請瀏覽: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            // 通用：列出所有停放的階段作業，手動挑要連哪一筆（TEST、GPV11V1 都適用）
            "type": "zOpenDebug",
            "request": "attach",
            "name": "Demo 1 - attach：列出停放的除錯階段作業",
            "connection": {
                "type": "zowe",
                "name": "zOpenDebug_1"
            },
            "allSessions": false,
            "trace": true
        },
        {
            // 通用：不送 JCL，連到第一筆停放的階段作業
            // 若同時有 TEST 與 GPV11V1 的階段作業停放，會連到哪一筆不確定，建議先結束舊的
            "type": "zOpenDebug",
            "request": "launch",
            "name": "Demo 2 - launch：連到第一筆停放的階段作業（不送 JCL）",
            "connection": {
                "type": "zowe",
                "name": "zOpenDebug_1"
            },
            "sessionId": "*",
            "terminateAndAbend": true,
            "trace": true
        },
        {
            // TEST 專用：只啟用 PROFILE-1（工作名稱需對應 TSTJJ 的 JOB 名稱 AZARLND）
            "type": "zOpenDebug",
            "request": "launch",
            "name": "Demo 3 - launch：自動送出 TSTJJ 並連線（TEST）",
            "connection": {
                "type": "zowe",
                "name": "zOpenDebug_1"
            },
            "profile": "PROFILE-1",
            "applicationLaunch": {
                "commandLine": "zowe rse submit data-set \"AZARLN.#TEST.PLI(TSTJJ)\""
            },
            "terminateAndAbend": true,
            "trace": true
        },
        {
            // GPV11V1 專用：只啟用 HAOKOH Profile（工作名稱需對應 P711V1D 的 JOB 名稱 HAOKOHR）
            // profile 名稱必須與 Z/OS DEBUGGER PROFILES 樹狀圖顯示的名稱完全相同
            "type": "zOpenDebug",
            "request": "launch",
            "name": "Demo 4 - launch：自動送出 P711V1D 並連線（GPV11V1）",
            "connection": {
                "type": "zowe",
                "name": "zOpenDebug_1"
            },
            "profile": "HAOKOH",
            "applicationLaunch": {
                "commandLine": "zowe rse submit data-set \"HAOKOH.#TEST.BTS(P711V1D)\""
            },
            "terminateAndAbend": true,
            "trace": true
        }
    ]
}
